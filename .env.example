# =========================================================
# Sportify Pro — Variables d'environnement
# Copier ce fichier en .env et adapter les valeurs
# =========================================================

# --- PostgreSQL (utilisé par docker-compose) ---
POSTGRES_USER=sportify
POSTGRES_PASSWORD=sportify
POSTGRES_DB=sportify

# --- Backend ---
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://sportify:sportify@localhost:5432/sportify

# JWT — générer des secrets forts en production (min. 32 caractères)
# Exemple : openssl rand -hex 32
JWT_ACCESS_SECRET=change-me-min-32-chars-access-secret-here
JWT_REFRESH_SECRET=change-me-min-32-chars-refresh-secret-here

BCRYPT_COST=10

# Origine CORS autorisée (URL du frontend)
CORS_ORIGIN=http://localhost:5173

# --- Frontend (Vite, build-time uniquement) ---
VITE_API_URL=http://localhost:3000/api
